<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#3326282E" />
            <stroke android:width="1dp" android:color="#338A8F9A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#1426282E" />
            <stroke android:width="1dp" android:color="#66E8C36A" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#33E8C36A" />
        </shape>
    </item>
</selector>
